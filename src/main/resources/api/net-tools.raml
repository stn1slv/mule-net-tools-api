#%RAML 1.0
title: Network connectivity tools
version: 3.0
securedBy: [basic]
securitySchemes:
  basic:
    type: Basic Authentication

traits:
  curlParams:
    headers:
      x-target-url:
        description: Target URL. Only http and https are allowed.
        type: string
      x-target-header:
        description: |
          A name: value header for the target request. Repeat for multiple headers.
          Content-Type is set for you from the content type of this request, so send
          it here only when the target should receive something different.
        required: false
        items:
          type: string
          example: |
            Content-Type: application/json
      x-target-insecure:
        description: Skip TLS certificate verification
        type: boolean
        required: false
        default: false
      x-target-user:
        description: |
          Credentials for the target. For basic this is user:password; for bearer it is
          the token on its own.
        type: string
        required: false
        example: alice:secret
      x-target-auth-type:
        description: Authentication scheme to use with x-target-user. Ignored when it is absent.
        type: string
        required: false
        default: basic
        enum: [basic, bearer]

/ping:
  get:
    description: Runs an ICMP test from the Mule host to the specified endpoint
    queryParameters:
      host:
        description: The domain or ip of the host to ping
        type: string
    responses: 
      200:
        body: 
          text/plain:
            example: |
              PING localhost (127.0.0.1): 56 data bytes
              64 bytes from 127.0.0.1: icmp_seq=0 ttl=64 time=0.050 ms
              64 bytes from 127.0.0.1: icmp_seq=1 ttl=64 time=0.070 ms
              64 bytes from 127.0.0.1: icmp_seq=2 ttl=64 time=0.054 ms
              64 bytes from 127.0.0.1: icmp_seq=3 ttl=64 time=0.046 ms

              --- localhost ping statistics ---
              4 packets transmitted, 4 packets received, 0.0% packet loss
              round-trip min/avg/max/stddev = 0.046/0.055/0.070/0.009 ms

/socket:
  get:
    description: Creates a TCP socket to test connectivity to an IP:Port combination
    queryParameters:
      host:
        description: The domain or ip of the host to be tested
        type: string
      port:
        description: The port number of host to be tested
        type: number
    responses: 
      200:
        body: 
          text/plain:
            example: |
              Connectivity is successful
/traceroute:
  get:
    description: Runs a traceroute test from the Mule host to the specified endpoint
    queryParameters:
      host:
        description: The domain or ip of the host to traceroute
        type: string
    responses: 
      200:
        body: 
          text/plain:
            example: |
               1  216.182.237.132  1.203 ms 216.182.237.128  1.185 ms 216.182.237.132  1.681 ms
               2  100.64.1.13  1.671 ms 100.64.1.235  1.337 ms 100.64.1.205  1.649 ms
               3  100.64.0.184  469.084 ms 100.64.0.210  992.624 ms 100.64.0.216  1012.502 ms
               4  100.64.16.43  0.777 ms 100.64.16.47  0.940 ms 100.64.16.91  0.904 ms
               5  72.21.222.221  1.588 ms 72.21.222.223  1.561 ms 72.21.222.221  1.581 ms
               6  54.240.242.42  12.569 ms 54.240.243.142  3.572 ms 54.240.242.102  18.003 ms
               7  54.240.243.93  1.225 ms 54.240.242.13  1.249 ms  1.244 ms
               8  52.95.216.113  1.092 ms  0.878 ms  0.972 ms
               9  216.239.50.189  1.963 ms 216.239.54.205  2.139 ms 216.239.49.9  1.962 ms
               10  216.239.58.213  2.424 ms 64.233.174.43  2.246 ms 216.239.58.215  1.577 ms
               11  8.8.8.8  1.824 ms  1.383 ms  1.339 ms
/dns:
  get:
    description: Resolves the specified endpoint's IP using the hosts DNS servers
    queryParameters:
      host:
        description: The the fully qualified domain name the host to test
        type: string
      dnsServer:
        description: The DNS server to use for resolution.        
        type: string
        required: false
    responses: 
      200:
        body: 
          text/plain:
            example: |
               127.0.0.1
/curl:
  description: |
    Relays an HTTP request from the Mule host to the target named in x-target-url.

    The method you call this resource with is the method the target receives, so a
    PUT here sends a PUT there. Any request body is forwarded to the target byte for
    byte, whatever its content type, and the target is told the same Content-Type you
    sent unless an x-target-header overrides it.
  get:
    description: Relays a GET to the target
    is: [curlParams]
    responses:
      200:
        body:
          text/plain:
            example: |
              curl: (7) Failed to connect to 10.200.27.15 port 443: Timed out
  post:
    description: Relays a POST to the target, with this request's body
    is: [curlParams]
    responses:
      200:
        body:
          text/plain:
            example: |
              HTTP/1.1 201 Created
  put:
    description: Relays a PUT to the target, with this request's body
    is: [curlParams]
    responses:
      200:
        body:
          text/plain:
            example: |
              HTTP/1.1 200 OK
  patch:
    description: Relays a PATCH to the target, with this request's body
    is: [curlParams]
    responses:
      200:
        body:
          text/plain:
            example: |
              HTTP/1.1 200 OK
  delete:
    description: Relays a DELETE to the target, with this request's body if it has one
    is: [curlParams]
    responses:
      200:
        body:
          text/plain:
            example: |
              HTTP/1.1 204 No Content

/ciphertest:
  get:
    description: Checks available SSL cipher suites for a given endpoint
    queryParameters:
      host:
        description: The domain or ip of the host to connect to
        type: string
      port:
        description: The port number of host to be tested
        type: number        
    responses: 
      200:
        body: 
          text/plain:
            example: List of supported ciphers...

/certest:
  get:
    description: Runs an SSL connection and pulls the certificates found
    queryParameters:
      host:
        description: The domain or ip of the host to connect to
        type: string
      port:
        description: The port number of host to be tested
        type: number
    responses:
      200:
        body:
          text/plain:
            example: CONNECTED(00000005)

/diagnostics:
  get:
    description: |
      Reports the diagnostic tooling available on the Mule worker itself, rather
      than probing a remote target. Currently the curl build, including its
      version, TLS backend and supported protocols.
    responses:
      200:
        body:
          text/plain:
            example: |
              curl 8.7.1 (x86_64-apple-darwin23.0) libcurl/8.7.1 (SecureTransport) LibreSSL/3.3.6 zlib/1.2.12
              Protocols: dict file ftp ftps gopher gophers http https imap imaps ldap ldaps mqtt pop3 pop3s rtsp smb smbs smtp smtps telnet tftp
              Features: alt-svc AsynchDNS GSS-API HSTS HTTP2 HTTPS-proxy IPv6 Kerberos Largefile libz MultiSSL NTLM SPNEGO SSL threadsafe UnixSockets
